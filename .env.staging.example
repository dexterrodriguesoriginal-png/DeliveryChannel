# Build de STAGING (copie para .env.staging — arquivo ignorado pelo git — e preencha com os valores
# do projeto Supabase de STAGING criado pelo fundador). Nunca coloque valores de produção aqui.
# Build: npx vite build --mode staging     (a guarda em src/lib/deployGuard.ts recusa configuração perigosa)
VITE_DEPLOY_TARGET=staging
VITE_BACKEND_SCHEMA=n1n6
# Ref do projeto de staging (Project Settings → General → Reference ID). 20 letras minúsculas.
VITE_STAGING_PROJECT_REF=
# Deve ser exatamente https://<VITE_STAGING_PROJECT_REF>.supabase.co
VITE_SUPABASE_URL=
# Publishable/anon key do STAGING (nunca secret/service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
