{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild server/payments/runRetention.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/payment-retention.cjs && esbuild server/dispatch/runRetention.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/dispatch-retention.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "payments:retention": "node dist/payment-retention.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "FE_IT_MODE=n1n6 vitest run -c vitest.integration.config.ts && FE_IT_MODE=legacy-020 vitest run -c vitest.integration.config.ts",
    "dispatch:retention": "node dist/dispatch-retention.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
