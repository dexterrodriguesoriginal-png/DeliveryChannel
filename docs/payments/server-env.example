# Somente Express/runtime. Nunca usar prefixo VITE_ nas credenciais abaixo.
# Overrides públicos opcionais. Vazios usam a configuração de produção versionada.
SUPABASE_URL=
PAYMENTS_PUBLIC_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AES-256-GCM: 32 bytes aleatórios codificados em 64 caracteres hexadecimais.
PAYMENTS_ENCRYPTION_KEY=
# Segredo aleatório de pelo menos 32 caracteres, diferente da chave de criptografia.
PAYMENTS_STATE_SECRET=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_TEST_TOKEN=false
PAGBANK_CLIENT_ID=
PAGBANK_CLIENT_SECRET=
PAGBANK_PLATFORM_TOKEN=
PAGBANK_SANDBOX=false
